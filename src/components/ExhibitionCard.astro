---
interface Props {
  title: string;
  thumb: string;
  fullImage: string;
}

const { title, thumb, fullImage } = Astro.props;
---

<div class="border-b border-line pb-4">
  <button
    type="button"
    class="js-open-lightbox group block w-full cursor-pointer border-0 bg-transparent p-0 text-left"
    data-full-src={fullImage}
    aria-label={`Ampliar flyer: ${title}`}
  >
    <div class="mb-4 aspect-[4/3] overflow-hidden bg-accent-soft">
      <img
        src={thumb}
        alt={title}
        class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.03] group-hover:opacity-90"
        loading="lazy"
        decoding="async"
      />
    </div>
    <h3
      class="font-display text-2xl font-medium tracking-tight text-ink group-hover:text-accent transition-colors"
    >
      {title}
    </h3>
  </button>
</div>

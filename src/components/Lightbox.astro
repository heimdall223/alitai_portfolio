---
/**
 * Accessible lightbox for exhibition flyers.
 */
---

<dialog id="lightbox-modal" aria-label="Imagen ampliada">
  <form method="dialog" class="absolute top-5 right-8">
    <button
      type="submit"
      class="border-0 bg-transparent text-4xl font-display leading-none text-paper cursor-pointer transition hover:text-accent-soft"
      aria-label="Cerrar"
    >
      &times;
    </button>
  </form>
  <img
    id="modal-image"
    src=""
    alt="Imagen ampliada"
    class="max-h-[90%] max-w-[90%] m-auto block"
  />
</dialog>

<script>
  function initLightbox() {
    const modal = document.getElementById('lightbox-modal');
    const modalImage = document.getElementById('modal-image');
    if (
      !(modal instanceof HTMLDialogElement) ||
      !(modalImage instanceof HTMLImageElement)
    ) {
      return;
    }

    const openButtons = document.querySelectorAll('.js-open-lightbox');

    function openLightbox(fullSrc: string) {
      modalImage.src = fullSrc;
      modal.showModal();
    }

    function closeLightbox() {
      modal.close();
      modalImage.src = '';
    }

    openButtons.forEach((el) => {
      el.addEventListener('click', () => {
        const fullSrc = el.getAttribute('data-full-src');
        if (fullSrc) openLightbox(fullSrc);
      });
    });

    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeLightbox();
    });

    modal.addEventListener('close', () => {
      modalImage.src = '';
    });
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>

---
interface Props {
  title: string;
  href: string;
  cover: string;
  coverAlt?: string;
}

const { title, href, cover, coverAlt = title } = Astro.props;
---

<a href={href} class="block">
  <div class="bg-gray-50 p-4 rounded-lg shadow hover:shadow-lg transition">
    <h3 class="text-xl font-bold mb-2 text-center">{title}</h3>
    <img
      src={cover}
      alt={coverAlt}
      class="rounded-md w-full h-48 object-cover"
      loading="lazy"
      decoding="async"
    />
  </div>
</a>

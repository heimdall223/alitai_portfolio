---
import { withBase } from '../lib/paths';

interface Props {
  handle: string;
  email: string;
  whatsapp: string;
  facebookUrl: string;
  instagramUrl: string;
}

const { handle, email, whatsapp, facebookUrl, instagramUrl } = Astro.props;

const linkClass =
  'inline-flex items-center justify-center opacity-80 transition hover:opacity-100';
---

<nav
  class="flex items-center justify-center gap-8"
  aria-label="Contacto y redes"
>
  <a
    href={facebookUrl}
    target="_blank"
    rel="noopener noreferrer"
    title="Facebook"
    class={linkClass}
  >
    <img
      src={withBase('/images/icons/face.png')}
      alt="Facebook"
      class="h-6 w-6"
      width="24"
      height="24"
    />
  </a>
  <a
    href={instagramUrl}
    target="_blank"
    rel="noopener noreferrer"
    title="Instagram"
    class={linkClass}
  >
    <img
      src={withBase('/images/icons/insta.png')}
      alt="Instagram"
      class="h-6 w-6"
      width="24"
      height="24"
    />
  </a>
  <a
    href={`https://wa.me/${whatsapp}`}
    target="_blank"
    rel="noopener noreferrer"
    title="WhatsApp"
    class={linkClass}
  >
    <img
      src={withBase('/images/icons/wsp.png')}
      alt="WhatsApp"
      class="h-6 w-6"
      width="24"
      height="24"
    />
  </a>
  <a href={`mailto:${email}`} title={`Email ${handle}`} class={linkClass}>
    <img
      src={withBase('/images/icons/mail.png')}
      alt="Email"
      class="h-6 w-6"
      width="24"
      height="24"
    />
  </a>
</nav>

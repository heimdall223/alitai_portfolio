---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { withBase } from '../lib/paths';

interface Props {
  works: CollectionEntry<'works'>[];
}

const { works } = Astro.props;

const slides = await Promise.all(
  works.map(async (work) => {
    const { Content } = await render(work);
    return { work, Content };
  }),
);
---

<div class="swiper work-carousel">
  <div class="swiper-wrapper">
    {
      slides.map(({ work, Content }) => (
        <div class="swiper-slide text-center p-4">
          <div
            class:list={[
              'w-full mx-auto flex items-center justify-center bg-gray-100 rounded-lg shadow-inner',
              work.data.orientation === 'portrait'
                ? 'max-w-md h-112'
                : 'max-w-3xl',
            ]}
          >
            <img
              src={withBase(work.data.image)}
              alt={work.data.title}
              class:list={[
                'object-contain',
                work.data.orientation === 'portrait'
                  ? 'max-h-full max-w-full'
                  : 'max-w-full h-auto',
              ]}
              loading="lazy"
              decoding="async"
            />
          </div>
          <h3 class="text-xl font-bold mt-4">{work.data.title}</h3>
          <p class="text-gray-600 italic">
            {work.data.technique} / Año {work.data.year}
          </p>
          <div class="mt-2 mb-2 text-sm text-justify bg-gray-100/50 backdrop-blur-sm rounded-lg shadow-lg p-4">
            <Content />
          </div>
        </div>
      ))
    }
  </div>
  <div class="swiper-button-prev" aria-label="Obra anterior"></div>
  <div class="swiper-button-next" aria-label="Obra siguiente"></div>
  <div class="swiper-pagination mt-12"></div>
</div>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, A11y } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';

  function initCarousel() {
    const el = document.querySelector('.work-carousel');
    if (!(el instanceof HTMLElement)) return;
    if (el.dataset.swiperInitialized === 'true') return;
    el.dataset.swiperInitialized = 'true';

    new Swiper(el, {
      modules: [Navigation, Pagination, A11y],
      loop: true,
      pagination: {
        el: el.querySelector('.swiper-pagination') as HTMLElement,
        clickable: true,
      },
      navigation: {
        nextEl: el.querySelector('.swiper-button-next') as HTMLElement,
        prevEl: el.querySelector('.swiper-button-prev') as HTMLElement,
      },
      a11y: {
        prevSlideMessage: 'Obra anterior',
        nextSlideMessage: 'Obra siguiente',
      },
    });
  }

  initCarousel();
  document.addEventListener('astro:page-load', initCarousel);
</script>

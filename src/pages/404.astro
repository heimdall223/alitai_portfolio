---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Página no encontrada - @Alitai">
  <main class="min-h-[60vh] flex flex-col items-center justify-center px-6 text-center">
    <h1 class="text-4xl font-bold mb-4">404</h1>
    <p class="text-gray-600 mb-8">No encontramos esta página.</p>
    <a href={withBase('/')} class="text-blue-600 hover:underline">← Volver al portfolio</a>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Página no encontrada - @Alitai">
  <main
    class="flex min-h-[70vh] flex-col items-center justify-center px-6 text-center"
  >
    <p class="font-display text-6xl font-medium text-ink">404</p>
    <p class="mt-4 text-ink-muted">No encontramos esta página.</p>
    <a
      href={withBase('/')}
      class="mt-8 text-sm text-accent transition hover:underline"
    >
      ← Volver al portfolio
    </a>
  </main>
</BaseLayout>

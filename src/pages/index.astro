---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeriesCard from '../components/SeriesCard.astro';
import ExhibitionCard from '../components/ExhibitionCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Lightbox from '../components/Lightbox.astro';
import BackToTop from '../components/BackToTop.astro';
import {
  getExhibitions,
  getPublishedSeries,
  getSiteSettings,
} from '../lib/content';
import { withBase } from '../lib/paths';

const settings = await getSiteSettings();
const seriesList = await getPublishedSeries();
const exhibitions = await getExhibitions();
const portraitUrl = withBase(settings.portrait);
---

<BaseLayout>
  <!-- HERO: marca + retrato full-bleed -->
  <section
    class="relative flex min-h-[100svh] items-end overflow-hidden bg-ink"
    aria-label="Portada"
  >
    <img
      src={portraitUrl}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center"
      width="1600"
      height="2000"
      decoding="async"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/35 to-ink/20"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 w-full px-6 pb-16 pt-32 sm:px-10 sm:pb-20 md:px-16">
      <p
        class="hero-animate font-display text-5xl font-medium leading-none tracking-tight text-paper sm:text-6xl md:text-7xl lg:text-8xl"
      >
        {settings.handle}
      </p>
      <p
        class="hero-animate-delay mt-4 max-w-xl font-sans text-base text-paper/85 sm:text-lg"
      >
        {settings.name} · {settings.role}
      </p>
      <a
        href="#trabajos"
        class="hero-animate-cta mt-8 inline-block border border-paper/40 px-6 py-3 text-sm font-medium tracking-wide text-paper transition hover:border-paper hover:bg-paper/10"
      >
        Ver trabajos
      </a>
    </div>
  </section>

  <!-- BIO -->
  <section class="border-b border-line px-6 py-20 sm:px-10 md:px-16" id="sobre-mi">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display text-4xl font-medium tracking-tight text-ink sm:text-5xl">
        Sobre mí
      </h2>
      <p class="mt-8 text-base leading-relaxed text-ink-muted sm:text-lg">
        {settings.bio}
      </p>
      <div class="mt-12">
        <SocialLinks
          handle={settings.handle}
          email={settings.email}
          whatsapp={settings.whatsapp}
          facebookUrl={settings.facebookUrl}
          instagramUrl={settings.instagramUrl}
        />
      </div>
    </div>
  </section>

  <!-- TRABAJOS -->
  <section class="px-6 py-20 sm:px-10 md:px-16" id="trabajos">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-display text-4xl font-medium tracking-tight text-ink sm:text-5xl">
        Trabajos
      </h2>
      <p class="mt-3 max-w-xl text-ink-muted">
        Series pictóricas. Elegí una para ver las obras.
      </p>
      <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          seriesList.map((entry) => (
            <SeriesCard
              title={entry.data.title}
              href={withBase(`/series/${entry.id}/`)}
              cover={withBase(entry.data.cover)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- EXHIBICIONES -->
  <section
    class="border-t border-line bg-accent-soft/40 px-6 py-20 sm:px-10 md:px-16"
    id="exhibiciones"
  >
    <div class="mx-auto max-w-5xl">
      <h2 class="font-display text-4xl font-medium tracking-tight text-ink sm:text-5xl">
        Exhibiciones
      </h2>
      <p class="mt-3 max-w-xl text-ink-muted">
        Tocá un flyer para ampliarlo.
      </p>
      <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          exhibitions.map((entry) => (
            <ExhibitionCard
              title={entry.data.title}
              thumb={withBase(entry.data.thumb)}
              fullImage={withBase(entry.data.fullImage)}
            />
          ))
        }
      </div>
      <Lightbox />
    </div>
  </section>

  <footer class="border-t border-line px-6 py-10 text-center">
    <p class="text-sm text-ink-muted">
      &copy; {settings.copyrightYear} @Alitai — Todos los derechos reservados
    </p>
  </footer>

  <BackToTop />
</BaseLayout>

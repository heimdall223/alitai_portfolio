---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCarousel from '../../components/WorkCarousel.astro';
import {
  getPublishedSeries,
  getSiteSettings,
  getWorksForSeries,
} from '../../lib/content';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const seriesList = await getPublishedSeries();
  return seriesList.map((entry) => ({
    params: { slug: entry.id },
    props: { series: entry },
  }));
}

const { series } = Astro.props;
const works = await getWorksForSeries(series.id);
const { Content } = await render(series);
const settings = await getSiteSettings();
const handle = settings.handle;
---

<BaseLayout
  title={`${series.data.title} - ${handle}`}
  description={series.data.description}
  ogImage={series.data.cover}
>
  <header class="border-b border-line px-6 py-10 sm:px-10 md:px-16">
    <div class="mx-auto max-w-3xl">
      <a
        href={withBase('/')}
        class="text-sm text-ink-muted transition hover:text-accent"
      >
        ← Portfolio
      </a>
      <h1
        class="mt-6 font-display text-4xl font-medium leading-tight tracking-tight text-ink sm:text-5xl md:text-6xl"
      >
        {series.data.title}
      </h1>
      <p class="mt-3 text-ink-muted">por {handle}</p>
    </div>
  </header>

  <section class="border-b border-line px-6 py-14 sm:px-10 md:px-16">
    <div class="mx-auto max-w-3xl">
      <dl
        class="grid gap-4 border-b border-line pb-8 text-sm sm:grid-cols-3"
      >
        <div>
          <dt class="text-ink-muted">Fecha</dt>
          <dd class="mt-1 font-medium text-ink">{series.data.dateRange}</dd>
        </div>
        <div>
          <dt class="text-ink-muted">Técnica</dt>
          <dd class="mt-1 font-medium text-ink">{series.data.technique}</dd>
        </div>
        <div>
          <dt class="text-ink-muted">Obras</dt>
          <dd class="mt-1 font-medium text-ink">{series.data.worksSummary}</dd>
        </div>
      </dl>
      <div
        class="mt-8 space-y-4 text-base leading-relaxed text-ink-muted [&_p]:mb-4"
      >
        <Content />
      </div>
    </div>
  </section>

  <section class="px-6 py-16 sm:px-10 md:px-16">
    <div class="mx-auto max-w-4xl">
      <h2
        class="mb-10 text-center font-display text-3xl font-medium tracking-tight text-ink sm:text-4xl"
      >
        Obras de la serie
      </h2>
      {
        works.length > 0 ? (
          <WorkCarousel works={works} />
        ) : (
          <p class="text-center text-ink-muted">Próximamente.</p>
        )
      }
    </div>
  </section>

  <footer class="border-t border-line px-6 py-10 text-center">
    <a
      href={withBase('/')}
      class="text-sm text-accent transition hover:underline"
    >
      ← Volver al portfolio
    </a>
  </footer>
</BaseLayout>
